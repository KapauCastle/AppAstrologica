<Window x:Class="CentroMedico.viewers.CreatePatientViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro Místico" Height="850" Width="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Palatino Linotype">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="EsotericLabel">
            <Setter Property="Foreground" Value="#4B2C5E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox" x:Key="EsotericInput">
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="30" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.2" Color="#2D1B36"/>
        </Border.Effect>

        <Grid Margin="50,10,50,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,100,0,40">
                <TextBlock Text="✨ Registro de Identidad ✨" FontSize="28" HorizontalAlignment="Center" Foreground="#2D1B36" FontWeight="Bold"/>
                <Rectangle Height="1.5" Fill="#E9D5FF" Margin="100,15,100,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                <StackPanel>
                    <TextBlock Text="👁️ Nombre del Paciente" Style="{StaticResource EsotericLabel}"/>
                    <TextBox x:Name="fullNameInput" Style="{StaticResource EsotericInput}" Margin="0,0,0,25" TextChanged="fullNameInput_TextChanged"/>

                    <Border Background="#F9F5FF" CornerRadius="15" Padding="25" Margin="0,0,0,25">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fecha de Nacimiento 🗓️" Style="{StaticResource EsotericLabel}"/>
                                <DatePicker x:Name="dobInput" Height="38" SelectedDateChanged="CalculateData"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Edad: " VerticalAlignment="Center" Foreground="#6B21A8" FontSize="12"/>
                                    <TextBlock x:Name="ageResultLabel" Text="--" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6B21A8" FontSize="16"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hora de Nacimiento ⏳" Style="{StaticResource EsotericLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="hourPicker" Width="65" Height="38"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" FontSize="18"/>
                                    <ComboBox x:Name="minutePicker" Width="65" Height="38"/>
                                    <ComboBox x:Name="ampmPicker" Width="75" Height="38" Margin="10,0,0,0">
                                        <ComboBoxItem Content="AM" IsSelected="True"/>
                                        <ComboBoxItem Content="PM"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#E9D5FF" BorderThickness="2" CornerRadius="15" Padding="25" Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="❈ CONFIGURACIÓN ASTRAL ❈" HorizontalAlignment="Center" Foreground="#6B21A8" FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sol ☀️" Style="{StaticResource EsotericLabel}" HorizontalAlignment="Center"/>
                                    <TextBox x:Name="sunSignResult" Style="{StaticResource EsotericInput}" IsReadOnly="True" Background="#FDFCFE" HorizontalContentAlignment="Center" BorderBrush="#E9D5FF" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Asc ✨" Style="{StaticResource EsotericLabel}" HorizontalAlignment="Center"/>
                                    <ComboBox x:Name="ascSignPicker" Height="38"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Luna 🌙" Style="{StaticResource EsotericLabel}" HorizontalAlignment="Center"/>
                                    <ComboBox x:Name="moonSignPicker" Height="38"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Género ⚧" Style="{StaticResource EsotericLabel}"/>
                            <ComboBox x:Name="genderPicker" Height="38">
                                <ComboBoxItem Content="Femenino"/>
                                <ComboBoxItem Content="Masculino"/>
                                <ComboBoxItem Content="No binario"/>
                                <ComboBoxItem Content="Otro"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="Estado Civil 💍" Style="{StaticResource EsotericLabel}"/>
                            <ComboBox x:Name="maritalStatusPicker" Height="38">
                                <ComboBoxItem Content="Soltero/a"/>
                                <ComboBoxItem Content="Casado/a"/>
                                <ComboBoxItem Content="Divorciado/a"/>
                                <ComboBoxItem Content="Viudo/a"/>
                                <ComboBoxItem Content="Unión Libre"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Escolaridad 📚" Style="{StaticResource EsotericLabel}"/>
                            <TextBox x:Name="educationInput" Style="{StaticResource EsotericInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="Religión 🕯️" Style="{StaticResource EsotericLabel}"/>
                            <TextBox x:Name="religionInput" Style="{StaticResource EsotericInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Ocupación ⚒️" Style="{StaticResource EsotericLabel}"/>
                            <TextBox x:Name="occupationInput" Style="{StaticResource EsotericInput}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="Nivel Socioeconómico 💎" Style="{StaticResource EsotericLabel}"/>
                            <TextBox x:Name="socioeconomicInput" Style="{StaticResource EsotericInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                            <TextBlock Text="Domicilio 🌿" Style="{StaticResource EsotericLabel}"/>
                            <TextBox x:Name="addressInput" Style="{StaticResource EsotericInput}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
                <Button Content="Descartar" Click="closeModal" Width="120" Height="45" Background="Transparent" BorderBrush="#D1D5DB" Cursor="Hand" Margin="0,0,20,0"/>
                <Button Content="Guardar Visita" Click="saveData" Width="200" Height="45" Background="#4B2C5E" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>