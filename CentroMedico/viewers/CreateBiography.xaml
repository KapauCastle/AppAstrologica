using System;
using System.Windows;
using System.Windows.Input;

namespace CentroMedico.viewers
{
/// <summary>
	/// Lógica de interacción para CreateBiography.xaml
	///
</summary>
public partial class CreateBiography : Window
{
public CreateBiography()
{
InitializeComponent();

// Permite arrastrar la ventana sin bordes haciendo clic en cualquier parte del fondo
this.MouseDown += (s, e) => {
if (e.LeftButton == MouseButtonState.Pressed)
this.DragMove();
};
}

// Este nombre debe coincidir con el Click="SaveBiography" del XAML
private void SaveBiography(object sender, RoutedEventArgs e)
{
// Aquí irá la lógica para salvar en la base de datos más adelante
MessageBox.Show("Crónica biográfica guardada en el cosmos.", "Éxito", MessageBoxButton.OK, MessageBoxImage.Information);
this.DialogResult = true;
this.Close();
}

// Este nombre debe coincidir con el Click="CloseModal" del XAML
private void CloseModal(object sender, RoutedEventArgs e)
{
this.Close();
}
}
}