<Window x:Class="CentroMedico.viewers.DetailsViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expediente Astral" Height="900" Width="1100"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#111827" FontFamily="Palatino Linotype">

	<Window.Resources>
		<SolidColorBrush x:Key="BarbiePink" Color="#E21884"/>
		<SolidColorBrush x:Key="GothPurple" Color="#2D1B36"/>
		<SolidColorBrush x:Key="MysticGold" Color="#D4AF37"/>
		<SolidColorBrush x:Key="SoftLavender" Color="#F3E8FF"/>

		<Style x:Key="BtnMystic" TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="BtnCircle" TargetType="Button">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Width" Value="46"/>
			<Setter Property="Height" Value="46"/>
			<Setter Property="Margin" Value="0,0,12,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="23" BorderBrush="#E9D5FF" BorderThickness="1.5">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DataTag" TargetType="Border">
			<Setter Property="Background" Value="#F3F4F6"/>
			<Setter Property="CornerRadius" Value="9"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="Margin" Value="0,0,10,10"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource GothPurple}" Height="80" Padding="25,0" BorderThickness="0,0,0,3" BorderBrush="{StaticResource BarbiePink}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Sesiones NCR" Foreground="{StaticResource BarbiePink}" FontSize="26" FontWeight="Bold"/>
				</StackPanel>
				<Button Grid.Column="1" Click="BtnRegresar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<TextBlock Text="Volver al Inicio" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
				</Button>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="50">
				<Border Background="White" CornerRadius="30" Padding="45">
					<StackPanel>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock x:Name="txtNombrePaciente" Text="CARGANDO..." FontSize="38" FontWeight="Bold" Foreground="{StaticResource GothPurple}" Margin="0,0,0,15"/>
								<WrapPanel>
									<Border Style="{StaticResource DataTag}" Background="{StaticResource SoftLavender}">
										<TextBlock x:Name="txtDatosBasicos" Text="📅 F. Nacim: --/--/--" Foreground="#6B21A8" FontSize="16" FontWeight="SemiBold"/>
									</Border>
									<Border Style="{StaticResource DataTag}">
										<TextBlock x:Name="txtGenero" Text="⚧ Género: --" Foreground="#374151" FontSize="16"/>
									</Border>
									<Border Style="{StaticResource DataTag}">
										<TextBlock x:Name="txtEstadoCivil" Text="💍 Estado Civil: --" Foreground="#374151" FontSize="16"/>
									</Border>
									<Border Style="{StaticResource DataTag}">
										<TextBlock x:Name="txtOcupacion" Text="⚒️ Ocupación: --" Foreground="#374151" FontSize="16"/>
									</Border>
									<Border Style="{StaticResource DataTag}">
										<TextBlock x:Name="txtEscolaridad" Text="📚 Escolaridad: --" Foreground="#374151" FontSize="16"/>
									</Border>
									<Border Style="{StaticResource DataTag}">
										<TextBlock x:Name="txtReligion" Text="🕯️ Religión: --" Foreground="#374151" FontSize="16"/>
									</Border>

									<TextBlock x:Name="txtUltimosDatos" Visibility="Collapsed"/>
									<TextBlock x:Name="txtTipoPaciente" Visibility="Collapsed"/>
								</WrapPanel>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
								<Button Style="{StaticResource BtnCircle}" Click="BtnEditar_Click">
									<Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Fill="#6B7280" Height="22" Stretch="Uniform"/>
								</Button>
								<Button Style="{StaticResource BtnCircle}" Click="BtnEliminar_Click">
									<Path Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" Fill="#EF4444" Height="22" Stretch="Uniform"/>
								</Button>
							</StackPanel>
						</Grid>

						<Separator Margin="0,30" Background="#F3E8FF"/>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,35">
							<Border Background="#FFFBEB" CornerRadius="16" Padding="18,12" Margin="0,0,18,0" BorderBrush="{StaticResource MysticGold}" BorderThickness="1.8" Width="165">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="SOL ☀️" FontSize="11" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,0,0,4"/>
									<TextBlock x:Name="lblSol" Text="--" FontSize="19" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<Border Background="#F5F3FF" CornerRadius="16" Padding="18,12" Margin="0,0,18,0" BorderBrush="#8B5CF6" BorderThickness="1.8" Width="165">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="ASCENDENTE ✨" FontSize="11" FontWeight="Bold" Foreground="#5B21B6" HorizontalAlignment="Center" Margin="0,0,0,4"/>
									<TextBlock x:Name="lblAsc" Text="--" FontSize="19" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<Border Background="#FDF2F8" CornerRadius="16" Padding="18,12" BorderBrush="{StaticResource BarbiePink}" BorderThickness="1.8" Width="165">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="LUNA 🌙" FontSize="11" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Center" Margin="0,0,0,4"/>
									<TextBlock x:Name="lblLuna" Text="--" FontSize="19" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<WrapPanel HorizontalAlignment="Center" Margin="0,0,0,45">
							<Button Content="✦ Biografía" Click="BtnBiografia_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource MysticGold}" Margin="6"/>
							<Button Content="✦ Antecedentes" Click="BtnHistopatografia_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource GothPurple}" Margin="6"/>
							<Button Content="✧ Seguimiento" Click="BtnSeguimiento_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource BarbiePink}" Margin="6"/>
							<Button Content="✨ Marcas Personales" Click="BtnMarcas_Click" Style="{StaticResource BtnMystic}" Background="#4B5563" Margin="6"/>
						</WrapPanel>

						<TextBlock Text="Antecedentes" FontWeight="Bold" FontSize="25" Foreground="{StaticResource GothPurple}" Margin="0,0,0,20"/>
						<ListView x:Name="listHistories" BorderThickness="0" Background="Transparent" Margin="0,0,0,30">
							<ListView.ItemTemplate>
								<DataTemplate>
									<Border Background="#FDFCFE" BorderBrush="{StaticResource SoftLavender}" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,10" Padding="20">
										<StackPanel>
											<TextBlock Text="{Binding type_history}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BarbiePink}" Margin="0,0,0,5"/>
											<TextBlock Text="{Binding history}" FontSize="16" Foreground="#374151" TextWrapping="Wrap"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>

						<TextBlock Text="Bitácora de Consultas" FontWeight="Bold" FontSize="25" Foreground="{StaticResource GothPurple}" Margin="0,10,0,25"/>
						<ListView x:Name="listHistorial" BorderThickness="0" Background="Transparent">
							<ListView.ItemTemplate>
								<DataTemplate>
									<Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="20" Margin="0,0,0,20" Padding="25">
										<StackPanel>
											<TextBlock Text="{Binding date, StringFormat='{}{0:dd MMMM yyyy}'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource GothPurple}" Margin="0,0,0,10"/>
											<TextBlock Text="{Binding diagnosis_treatment}" FontSize="16" TextWrapping="Wrap" Foreground="#4B5563"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>