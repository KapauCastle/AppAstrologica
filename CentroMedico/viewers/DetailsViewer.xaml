<Window x:Class="CentroMedico.viewers.DetailsViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expediente Astral" Height="850" Width="1100"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized" 
        Background="#111827"
        FontFamily="Palatino Linotype">

    <Window.Resources>
        <SolidColorBrush x:Key="BarbiePink" Color="#E21884"/>
        <SolidColorBrush x:Key="GothPurple" Color="#2D1B36"/>
        <SolidColorBrush x:Key="MysticGold" Color="#D4AF37"/>
        <SolidColorBrush x:Key="SoftLavender" Color="#F3E8FF"/>

        <Style x:Key="BtnMystic" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCircle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="#E9D5FF" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource GothPurple}" Height="80" Padding="25,0" BorderThickness="0,0,0,3" BorderBrush="{StaticResource BarbiePink}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" Width="50" Height="50" CornerRadius="25" Margin="0,0,15,0">
                        <Image Source="pack://application:,,,/assets/logo_bebe.png" Margin="5" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sesiones NCR" Foreground="{StaticResource BarbiePink}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="✦ Expedientes del Akasha ✦" Foreground="{StaticResource MysticGold}" FontSize="12" FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="BtnRegresar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" Foreground="{StaticResource BarbiePink}" FontWeight="Bold" FontSize="22" Margin="0,0,10,0"/>
                        <TextBlock Text="Volver al Inicio" Foreground="White" VerticalAlignment="Center" FontSize="16"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="50">
                <Border Background="White" CornerRadius="30" Padding="45">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.4" Color="#E21884"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtNombrePaciente" Text="CARGANDO NOMBRE..." FontSize="36" FontWeight="Bold" Foreground="{StaticResource GothPurple}" Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{StaticResource SoftLavender}" CornerRadius="12" Padding="15,8" Margin="0,0,15,0">
                                        <TextBlock x:Name="txtDatosBasicos" Text="F. Nacim: --/--/--" Foreground="#6B21A8" FontSize="18" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FDF2F8" CornerRadius="12" Padding="15,8">
                                        <TextBlock x:Name="txtUltimosDatos" Text="Peso: -- kg • Altura: -- cm" Foreground="{StaticResource BarbiePink}" FontSize="18" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource BtnCircle}" Click="BtnEditar_Click">
                                    <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" Fill="#6B7280" Height="22" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource BtnCircle}" Click="BtnEliminar_Click">
                                    <Path Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" Fill="#EF4444" Height="22" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,40" Background="#F3E8FF"/>

                        <TextBlock Text="✦ Configuración del Alma ✦" Foreground="{StaticResource MysticGold}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Border Background="#FFFBEB" CornerRadius="15" Padding="15,10" Margin="0,0,15,0" BorderBrush="{StaticResource MysticGold}" BorderThickness="1.5" Width="180">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SOL ☀️" FontSize="10" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="lblSol" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F3FF" CornerRadius="15" Padding="15,10" Margin="0,0,15,0" BorderBrush="#8B5CF6" BorderThickness="1.5" Width="180">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="ASCENDENTE ✨" FontSize="10" FontWeight="Bold" Foreground="#5B21B6" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="lblAsc" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FDF2F8" CornerRadius="15" Padding="15,10" BorderBrush="{StaticResource BarbiePink}" BorderThickness="1.5" Width="180">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="LUNA 🌙" FontSize="10" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                    <TextBlock x:Name="lblLuna" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Background="{StaticResource GothPurple}" CornerRadius="15" Padding="20" Margin="0,0,0,40">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="ENERGÍA DEL CONSULTANTE:" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BarbiePink}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <TextBlock x:Name="txtTipoPaciente" Text="--" FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                            <Button Content="✦ Histopatobiografía" Click="BtnHistopatografia_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource GothPurple}" Margin="0,0,20,0"/>
                            <Button Content="✧ Seguimiento y Avance" Click="BtnSeguimiento_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource BarbiePink}"/>
                        </StackPanel>

                        <TextBlock Text="Antecedentes y Aspectos" FontWeight="Bold" FontSize="24" Foreground="{StaticResource GothPurple}" Margin="0,0,0,20"/>
                        <ListView x:Name="listHistories" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FDFCFE" BorderBrush="{StaticResource SoftLavender}" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,15" Padding="25">
                                        <StackPanel>
                                            <TextBlock Text="{Binding type_history}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BarbiePink}" Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding history}" FontSize="18" Foreground="#374151" TextWrapping="Wrap" LineHeight="26"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Separator Margin="0,40" Background="#F3E8FF"/>

                        <TextBlock Text="Bitácora de Encuentros Astrales" FontWeight="Bold" FontSize="24" Foreground="{StaticResource GothPurple}" Margin="0,0,0,25"/>
                        <ListView x:Name="listHistorial" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="20" Margin="0,0,0,20" Padding="30">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,15">
                                                <TextBlock Text="{Binding date, StringFormat='{}{0:dd MMMM yyyy}'}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource GothPurple}"/>
                                                <TextBlock Text="{Binding type_consultation}" HorizontalAlignment="Right" Foreground="{StaticResource BarbiePink}" FontSize="16" FontWeight="SemiBold"/>
                                            </Grid>
                                            <TextBlock Text="Diagnóstico del Cosmos:" FontWeight="Bold" FontSize="16" Foreground="#6B21A8" Margin="0,10,0,5"/>
                                            <TextBlock Text="{Binding diagnosis_treatment}" FontSize="18" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,15"/>
                                            <TextBlock Text="Evolución de la Energía:" FontWeight="Bold" FontSize="16" Foreground="#6B21A8" Margin="0,5,0,5"/>
                                            <TextBlock Text="{Binding observations}" FontSize="18" TextWrapping="Wrap" FontStyle="Italic" Foreground="#4B5563"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>