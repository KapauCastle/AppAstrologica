<Window x:Class="CentroMedico.viewers.CreateHistoryViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agregar Antecedente" Height="580" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Palatino Linotype">

	<Window.Resources>
		<Style TargetType="TextBlock" x:Key="EsotericLabel">
			<Setter Property="Foreground" Value="#4B2C5E"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="0,0,0,5"/>
		</Style>

		<Style TargetType="TextBox" x:Key="EsotericInput">
			<Setter Property="Height" Value="40"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="10,0"/>
			<Setter Property="BorderBrush" Value="#D1D5DB"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="25" Margin="15">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#2D1B36"/>
		</Border.Effect>

		<Grid Margin="35,10,35,30">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Margin="0,70,0,35">
				<TextBlock Text="✨ Agregar Antecedente ✨" FontSize="24" HorizontalAlignment="Center" Foreground="#2D1B36" FontWeight="Bold"/>
				<Rectangle Height="1" Fill="#E9D5FF" Margin="80,12,80,0"/>
			</StackPanel>

			<StackPanel Grid.Row="1">
				<StackPanel Margin="0,0,0,25">
					<TextBlock Text="🔮 Tipo de Antecedente" Style="{StaticResource EsotericLabel}"/>
					<TextBox x:Name="typeInput" Style="{StaticResource EsotericInput}" Tag="Ej. Heredofamiliar, Patológico..."/>
				</StackPanel>

				<StackPanel>
					<TextBlock Text="📜 Descripción / Detalle" Style="{StaticResource EsotericLabel}"/>
					<TextBox x:Name="historyInput" Height="140"
                             BorderBrush="#D1D5DB" BorderThickness="1" Background="White" Padding="12"
                             VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True">
						<TextBox.Template>
							<ControlTemplate TargetType="TextBox">
								<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
									<ScrollViewer x:Name="PART_ContentHost"/>
								</Border>
							</ControlTemplate>
						</TextBox.Template>
					</TextBox>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,10">
				<Button Content="Descartar" Click="CloseModal"
                        Background="Transparent" Foreground="#4B2C5E" BorderBrush="#D1D5DB" BorderThickness="1"
                        Width="110" Height="42" Margin="0,0,15,0" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Button Content="Guardar" Click="SaveHistory"
                        Background="#4B2C5E" Foreground="White" BorderThickness="0"
                        Width="140" Height="42" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" CornerRadius="10">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="Bold"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>
		</Grid>
	</Border>
</Window>