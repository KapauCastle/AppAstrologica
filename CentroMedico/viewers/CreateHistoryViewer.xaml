<Window x:Class="CentroMedico.viewers.DetailsViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expediente Astral" Height="850" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#111827"
        FontFamily="Palatino Linotype">

	<Window.Resources>
		<SolidColorBrush x:Key="BarbiePink" Color="#E21884"/>
		<SolidColorBrush x:Key="GothPurple" Color="#2D1B36"/>
		<SolidColorBrush x:Key="MysticGold" Color="#D4AF37"/>
		<SolidColorBrush x:Key="SoftLavender" Color="#F3E8FF"/>

		<Style x:Key="BtnMystic" TargetType="Button">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Padding" Value="20,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DataTag" TargetType="Border">
			<Setter Property="Background" Value="#F3F4F6"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12,5"/>
			<Setter Property="Margin" Value="0,0,10,10"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Border Grid.Row="0" Background="{StaticResource GothPurple}" Height="80" Padding="25,0" BorderThickness="0,0,0,3" BorderBrush="{StaticResource BarbiePink}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Sesiones NCR" Foreground="{StaticResource BarbiePink}" FontSize="25" FontWeight="Bold"/>
				</StackPanel>
				<Button Grid.Column="1" Click="BtnRegresar_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
					<TextBlock Text="Volver al Inicio" Foreground="White" FontSize="16"/>
				</Button>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="50">
				<Border Background="White" CornerRadius="30" Padding="45">
					<Border.Effect>
						<DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.4" Color="#E21884"/>
					</Border.Effect>

					<StackPanel>
						<TextBlock x:Name="txtNombrePaciente" Text="CARGANDO..." FontSize="36" FontWeight="Bold" Foreground="{StaticResource GothPurple}" Margin="0,0,0,15"/>

						<WrapPanel>
							<Border Style="{StaticResource DataTag}" Background="{StaticResource SoftLavender}">
								<TextBlock x:Name="txtFechaNac" Text="📅 F. Nacim: --/--/--" Foreground="#6B21A8" FontSize="15" FontWeight="SemiBold"/>
							</Border>
							<Border Style="{StaticResource DataTag}">
								<TextBlock x:Name="txtGenero" Text="⚧ Género: --" Foreground="#374151" FontSize="15"/>
							</Border>
							<Border Style="{StaticResource DataTag}">
								<TextBlock x:Name="txtEstadoCivil" Text="💍 Estado Civil: --" Foreground="#374151" FontSize="15"/>
							</Border>
							<Border Style="{StaticResource DataTag}">
								<TextBlock x:Name="txtOcupacion" Text="⚒️ Ocupación: --" Foreground="#374151" FontSize="15"/>
							</Border>
							<Border Style="{StaticResource DataTag}">
								<TextBlock x:Name="txtEscolaridad" Text="📚 Escolaridad: --" Foreground="#374151" FontSize="15"/>
							</Border>
							<Border Style="{StaticResource DataTag}">
								<TextBlock x:Name="txtReligion" Text="🕯️ Religión: --" Foreground="#374151" FontSize="15"/>
							</Border>

							<TextBlock x:Name="txtUltimosDatos" Visibility="Collapsed"/>
							<TextBlock x:Name="txtTipoPaciente" Visibility="Collapsed"/>
						</WrapPanel>

						<Separator Margin="0,40" Background="#F3E8FF"/>

						<TextBlock Text="✦ Configuración del Alma ✦" Foreground="{StaticResource MysticGold}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
							<Border Background="#FFFBEB" CornerRadius="15" Padding="15,10" Margin="0,0,15,0" BorderBrush="{StaticResource MysticGold}" BorderThickness="1.5" Width="180">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="SOL ☀️" FontSize="10" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Center"/>
									<TextBlock x:Name="lblSol" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<Border Background="#F5F3FF" CornerRadius="15" Padding="15,10" Margin="0,0,15,0" BorderBrush="#8B5CF6" BorderThickness="1.5" Width="180">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="ASCENDENTE ✨" FontSize="10" FontWeight="Bold" Foreground="#5B21B6" HorizontalAlignment="Center"/>
									<TextBlock x:Name="lblAsc" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
							<Border Background="#FDF2F8" CornerRadius="15" Padding="15,10" BorderBrush="{StaticResource BarbiePink}" BorderThickness="1.5" Width="180">
								<StackPanel HorizontalAlignment="Center">
									<TextBlock Text="LUNA 🌙" FontSize="10" FontWeight="Bold" Foreground="#BE185D" HorizontalAlignment="Center"/>
									<TextBlock x:Name="lblLuna" Text="--" FontSize="18" FontWeight="Bold" Foreground="{StaticResource GothPurple}" HorizontalAlignment="Center"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
							<Button Content="✦ Biografía" Click="BtnBiografia_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource MysticGold}" Margin="0,0,20,0"/>
							<Button Content="✦ Histopatobiografía" Click="BtnHistopatografia_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource GothPurple}" Margin="0,0,20,0"/>
							<Button Content="✧ Seguimiento" Click="BtnSeguimiento_Click" Style="{StaticResource BtnMystic}" Background="{StaticResource BarbiePink}"/>
						</StackPanel>

						<TextBlock Text="Antecedentes" FontWeight="Bold" FontSize="24" Foreground="{StaticResource GothPurple}" Margin="0,0,0,20"/>
						<ListView x:Name="listHistories" BorderThickness="0" Background="Transparent">
							<ListView.ItemTemplate>
								<DataTemplate>
									<Border Background="#FDFCFE" BorderBrush="{StaticResource SoftLavender}" BorderThickness="1.5" CornerRadius="15" Margin="0,0,0,15" Padding="25">
										<StackPanel>
											<TextBlock Text="{Binding type_history}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BarbiePink}" Margin="0,0,0,10"/>
											<TextBlock Text="{Binding history}" FontSize="18" Foreground="#374151" TextWrapping="Wrap"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>

						<TextBlock Text="Bitácora" FontWeight="Bold" FontSize="24" Foreground="{StaticResource GothPurple}" Margin="0,40,0,25"/>
						<ListView x:Name="listHistorial" BorderThickness="0" Background="Transparent">
							<ListView.ItemTemplate>
								<DataTemplate>
									<Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="20" Margin="0,0,0,20" Padding="30">
										<StackPanel>
											<TextBlock Text="{Binding diagnosis_treatment}" FontSize="18" TextWrapping="Wrap" Foreground="#4B5563"/>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>