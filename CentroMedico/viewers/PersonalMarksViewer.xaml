<Window x:Class="CentroMedico.viewers.PersonalMarksViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marcas Personales" Height="600" Width="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Palatino Linotype">

	<Window.Resources>
		<Style TargetType="CheckBox">
			<Setter Property="Foreground" Value="#4B2C5E"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Margin" Value="0,5,15,5"/>
		</Style>

		<Style TargetType="TextBlock" x:Key="SectionHeader">
			<Setter Property="Foreground" Value="#2D1B36"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Margin" Value="0,15,0,10"/>
		</Style>

		<Style x:Key="RoundedButtonStyle" TargetType="Button">
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Background="White" CornerRadius="30" Margin="15">
		<Border.Effect>
			<DropShadowEffect BlurRadius="25" Opacity="0.2" Color="#2D1B36"/>
		</Border.Effect>

		<Grid Margin="30">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Margin="0,10,0,20">
				<TextBlock Text="✨ Marcas Personales ✨"
                           FontSize="24" HorizontalAlignment="Center"
                           Foreground="#2D1B36" FontWeight="Bold"/>
				<Rectangle Height="1.2" Fill="#E9D5FF" Margin="60,10,60,0"/>
			</StackPanel>

			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<StackPanel>
					<TextBlock Text="Selecciona las categorías presentes:" Style="{StaticResource SectionHeader}"/>

					<WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
						<CheckBox x:Name="chkTatuaje" Content="Tatuajes"/>
						<CheckBox x:Name="chkCicatriz" Content="Cicatrices"/>
						<CheckBox x:Name="chkLunar" Content="Lunares Estéticos"/>
						<CheckBox x:Name="chkMancha" Content="Manchas de Nacimiento"/>
						<CheckBox x:Name="chkPerforacion" Content="Perforaciones"/>
						<CheckBox x:Name="chkOtro" Content="Otras Marcas"/>
					</WrapPanel>

					<TextBlock Text="Descripción detallada y ubicación:" Style="{StaticResource SectionHeader}"/>
					<Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="12" Padding="5">
						<TextBox x:Name="txtDescripcionDetallada"
                                 Height="220"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalScrollBarVisibility="Auto"/>
					</Border>
				</StackPanel>
			</ScrollViewer>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">

				<Button Content="Descartar" Click="CloseModal"
                        Style="{StaticResource RoundedButtonStyle}"
                        Width="110" Height="40"
                        Background="Transparent"
                        Foreground="#4B5563"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Margin="0,0,12,0"/>

				<Button Content="Guardar Registro" Click="SaveMarks"
                        Style="{StaticResource RoundedButtonStyle}"
                        Width="160" Height="40"
                        Background="#4B2C5E"
                        Foreground="White"
                        FontWeight="Bold"/>

			</StackPanel>
		</Grid>
	</Border>
</Window>